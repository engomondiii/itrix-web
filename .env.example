# itriX web environment contract
# Copy to a local env file only for development. Never commit real credentials.
# Boolean feature flags are true only when the literal value is "true", except the two
# signup flags noted below which default ON and are disabled only by literal "false".

# -----------------------------------------------------------------------------
# Core URLs
# -----------------------------------------------------------------------------
# REQUIRED in production. Public canonical site URL. Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://web.example.invalid

# REQUIRED in production. Browser-visible Django API base, including /api/v1.
# Local default: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=https://api.example.invalid/api/v1

# Recommended server-only BFF API base. When omitted, BFF routes fall back to
# NEXT_PUBLIC_API_URL. Do not put credentials in this URL.
API_URL=https://api.example.invalid/api/v1

# REQUIRED only when NEXT_PUBLIC_ENABLE_REALTIME=true. Use wss: when the site is https:.
# Backend counterpart: ENABLE_REALTIME and REDIS_URL/channel-layer configuration.
NEXT_PUBLIC_WS_URL=wss://api.example.invalid/ws

# -----------------------------------------------------------------------------
# Legal publication / governed links
# -----------------------------------------------------------------------------
# REQUIRED true for the current production MVP while open signup is enabled.
# Backend counterpart: LEGAL_PUBLISHED plus the LEGAL_* version/effective settings.
NEXT_PUBLIC_LEGAL_PUBLISHED=true

# Required when Markdown turns are enabled. Comma-separated hostnames only: no schemes,
# paths, quotes or credentials. Safe to keep narrow.
NEXT_PUBLIC_MARKDOWN_LINK_ALLOWED_HOSTS=arxiv.org,itrix.co.kr

# -----------------------------------------------------------------------------
# Account and portal surface
# -----------------------------------------------------------------------------
# Kill switch. DEFAULT ON; only literal false closes self-serve registration.
# Backend counterpart: ENABLE_OPEN_SIGNUP.
NEXT_PUBLIC_ENABLE_OPEN_SIGNUP=true

# Invitation-code option on signup. DEFAULT ON; only literal false disables it.
NEXT_PUBLIC_ENABLE_SIGNUP_INVITE_CODE=true

# Client workspace. Safe to leave false until the backend counterpart is enabled.
# Backend counterpart: ENABLE_CLIENT_PORTAL.
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL=false

# Designed authentication-zone feature marker. Current auth routes still exist when false;
# this is retained for rollout compatibility.
NEXT_PUBLIC_ENABLE_AUTH_ZONE=false

# Password reset UI/backend integration. Safe to leave false until backend reset is ready.
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=false

# Legal assent recording integration. The checkbox still blocks locally when false.
# Backend counterpart: legal assent endpoints/current legal metadata.
NEXT_PUBLIC_ENABLE_LEGAL_ASSENT=false

# -----------------------------------------------------------------------------
# Conversation / journey
# -----------------------------------------------------------------------------
# Conversation shell. Backend counterpart: ENABLE_CONVERSATION_SURFACE.
NEXT_PUBLIC_ENABLE_CONVERSATION_SURFACE=false

# Trust backend shell_mode/two-mode behavior only after the corresponding backend contract
# is deployed. Safe to leave false.
NEXT_PUBLIC_ENABLE_TWO_MODE_SHELL=false

# Third-zone content pane. Safe to leave false.
NEXT_PUBLIC_ENABLE_CONTENT_PANE=false

# Render Markdown in assistant turns. Requires marker-normalized backend stream governance
# and NEXT_PUBLIC_MARKDOWN_LINK_ALLOWED_HOSTS.
NEXT_PUBLIC_ENABLE_MARKDOWN_TURNS=false

# Stream assistant turns. Backend counterpart: ENABLE_ANONYMOUS_STREAMING for anonymous use.
NEXT_PUBLIC_ENABLE_STREAMING_TURNS=false

# Realtime WebSocket transport. Requires NEXT_PUBLIC_WS_URL and backend ENABLE_REALTIME.
NEXT_PUBLIC_ENABLE_REALTIME=false

# Adaptive generated follow-up questions. Backend counterpart: ENABLE_ADAPTIVE_QUESTIONS.
NEXT_PUBLIC_ENABLE_ADAPTIVE_QUESTIONS=false

# -----------------------------------------------------------------------------
# Customer / governed feature surfaces
# -----------------------------------------------------------------------------
# Any-format uploads. Backend counterpart: ENABLE_ATTACHMENTS. Production backend also
# requires durable ATTACHMENT_BLOB_ROOT and external ATTACHMENT_AV_COMMAND.
NEXT_PUBLIC_ENABLE_ATTACHMENTS=false

# State-10 customer-success zone. Backend counterpart: ENABLE_CUSTOMER_SUCCESS.
NEXT_PUBLIC_ENABLE_CUSTOMER_SUCCESS=false

# Embedded governed agent chat. Backend counterpart: ENABLE_AGENTS.
NEXT_PUBLIC_ENABLE_AGENT_CHAT=false

# No production client-side observability credential is currently consumed by this repo.
# trackEvent writes to an existing window.dataLayer when one is supplied by the host page.
