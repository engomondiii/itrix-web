{
  "name": "itrix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:retry": "playwright test tests/e2e/try-again-recovery.spec.ts",
    "test:e2e:matrix": "node scripts/verify-playwright-release-matrix.mjs",
    "test:e2e:base": "playwright test --config=playwright.base.config.ts",
    "test:e2e:bff": "playwright test --config=playwright.bff.config.ts",
    "test:e2e:realtime": "playwright test --config=playwright.realtime.config.ts",
    "test:e2e:adaptive": "playwright test --config=playwright.adaptive.config.ts",
    "test:e2e:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "test:e2e:release": "npm run test:e2e:matrix && npm run test:e2e:base && npm run test:e2e:bff && npm run test:e2e:realtime && npm run test:e2e:adaptive && npm run test:e2e:accessibility"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@playwright/test": "^1.55.0"
  }
}
